-- vpfxs encodings, read back --
default:      000000e4
x,y,z,w:      000000e4
w,z,y,x:      0000001b
x,x,x,x:      00000000
-x,-y,-z,-w:  000f00e4
|x|..|w|:     00000fe4
-|x|..-|w|:   000f0fe4
0,1,2,3:      0000f824
1/2,1/3,1/4,1/6: 0000fee7
-1,-2,-3,-1/2: 000ff4c9
-y,|w|,2,-1/3: 0009ca6d
vpfxt 1,1/2,3,0: 0000f40d
-- vpfxd encodings, read back --
0:1 x4:       00000055
-1:1 x4:      000000ff
m x4:         00000f00
0:1,m,-1:1,m:  00000a31
m,-1:1,0:1,m: 0000091c
-- written with mtvc --
readback: 000f00b1,0000f40d,00000055
vadd.q with them               3f800000,00000000,3f800000,00000000
readback: 000fffff,000fffff,00000fff
vadd.q with all bits           3f800000,00000000,3f800000,00000000
readback: 00000000,00000000,00000f00
vadd.q with high bits          3f800000,00000000,3f800000,00000000
readback: 000000e4,000000e4,00000000
vadd.q with defaults           41380000,418c0000,42060000,420e0000
readback: 00000000,00000000,00000000
vadd.q with zeros              41380000,41380000,41380000,41380000
-- prefix lanes outside the op size --
vadd.s [y,y,y,y]               00000000,00000000,00000000,00000000
vadd.s [w,w,w,w]               00000000,00000000,00000000,00000000
vadd.s [-|w|,x,x,x]            00000000,00000000,00000000,00000000
vadd.p [z,w,x,y]               00000000,00000000,00000000,00000000
vadd.p [w,z,y,x]               00000000,00000000,00000000,00000000
vadd.t [w,w,w,x]               00000000,00000000,00000000,00000000
vadd.t [x,y,z,-w]              41380000,418c0000,42060000,00000000
vadd.p [x,y,-z,|w|]            41380000,418c0000,00000000,00000000
