-- vcmp in the delay slot --
CC=0, bvt 0, slot sets bit:    not taken
CC=3f, bvt 0, slot clears bit: taken
CC=3f, bvf 0, slot clears bit: not taken
CC=0, bvf 0, slot sets bit:    taken
CC=0, bvt 4, slot sets bit:    not taken
CC=0, bvtl 0, slot sets bit:   not taken
CC=3f, bvfl 0, slot clears bit: not taken
CC after bvt (not taken) with slot vcmp EQ true:  31
CC after bvt (taken) with slot vcmp EQ false:     0e
CC after bvtl (not taken) with slot vcmp EQ true: 00
CC after bvtl (taken) with slot vcmp EQ false:    0e
-- vcmp immediately before the branch --
1 < 2, bvt: taken
2 < 1, bvt: not taken
1 < 2, bvf: not taken
2 < 1, bvf: taken
-- vcmp.q LT lane bits through branches --
[1,5,1,5] < 2: 15
[1,1,1,1] < 2: 3f
[5,5,5,5] < 2: 00
