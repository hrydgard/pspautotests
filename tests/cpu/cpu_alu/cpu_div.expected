-- div by zero --
div 00000000 / 0: lo=ffffffff hi=00000000
div 00000001 / 0: lo=ffffffff hi=00000001
div ffffffff / 0: lo=00000001 hi=ffffffff
div 00000002 / 0: lo=ffffffff hi=00000002
div 00000064 / 0: lo=ffffffff hi=00000064
div ffffff9c / 0: lo=00000001 hi=ffffff9c
div 7fffffff / 0: lo=ffffffff hi=7fffffff
div 80000000 / 0: lo=00000001 hi=80000000
div 12345678 / 0: lo=ffffffff hi=12345678
div f2345678 / 0: lo=00000001 hi=f2345678
-- divu by zero --
divu 00000000 / 0: lo=0000ffff hi=00000000
divu 00000001 / 0: lo=0000ffff hi=00000001
divu ffffffff / 0: lo=ffffffff hi=ffffffff
divu 00000002 / 0: lo=0000ffff hi=00000002
divu 00000064 / 0: lo=0000ffff hi=00000064
divu ffffff9c / 0: lo=ffffffff hi=ffffff9c
divu 7fffffff / 0: lo=ffffffff hi=7fffffff
divu 80000000 / 0: lo=ffffffff hi=80000000
divu 12345678 / 0: lo=ffffffff hi=12345678
divu f2345678 / 0: lo=ffffffff hi=f2345678
-- overflow --
div 80000000 / -1: lo=80000000 hi=00000000
divu 80000000 / ffffffff: lo=00000000 hi=80000000
-- normal --
div 00000000 / 7: lo=00000000 hi=00000000
div 00000000 / -7: lo=00000000 hi=00000000
divu 00000000 / 7: lo=00000000 hi=00000000
div 00000001 / 7: lo=00000000 hi=00000001
div 00000001 / -7: lo=00000000 hi=00000001
divu 00000001 / 7: lo=00000000 hi=00000001
